</div>

<style webc:scoped>
  .heading {
    font-family: var(--font-accent);
    font-size: var(--font-size-14);
    padding-bottom: 0.5rem;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: calc(var(--g-gutter) * 0.5);
    grid-auto-rows: 1fr;
    grid-template-columns: 1fr;
    max-width: var(--g-max-11);
  }

  li {
    display: flex;
  }

  a {
    align-items: center;
    background-color: var(--color-accent-primary);
    box-shadow: inset 0 0 0 6px var(--border-color, transparent);
    color: var(--color-offwhite);
    display: flex;
    flex: 1;
    justify-content: center;
    padding: var(--py, 2.75rem) 2.25rem;
    position: relative;
    text-align: center;
    text-decoration: none;

    &.nav--current {
      cursor: default;

      &::after {
        bottom: 0;
        content: "You are here\A\29BF";
        display: block;
        font-family: var(--font-accent);
        font-size: var(--font-size-14);
        font-weight: 500;
        padding-bottom: 0.75rem;
        position: absolute;
        text-transform: uppercase;
        white-space: pre-line;
        width: 100%;
      }
    }

    &.nav--current,
    &:hover,
    &:focus-visible {
      --border-color: hsla(0 0 100 / 0.3);
      outline: none;
    }

    &:active :where(img, svg:not(.strokes), div) {
      transform: scale3d(0.94, 0.94, 0.94);
    }
  }

  @supports (background-color: attr(x type(<color>))) {
    a {
      background-color: attr(
        data-bg type(<color>),
        var(--color-accent-primary)
      );
    }
  }

  img,
  svg:not(.strokes) {
    display: block;
    height: auto;
    margin: 0 auto;
    max-width: calc(280 / 16 * 1rem);
    position: relative;
    width: 75%;
    z-index: 1;
  }

  .strokes {
    display: block;
    height: 100%;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    width: 100%;
    z-index: 0;
  }

  a:not(.nav--current):hover .strokes,
  a:not(.nav--current):focus-visible .strokes {
    opacity: 0.5;
  }

  .nav-pezzos {
    svg:not(.strokes) {
      max-width: 96px;
    }
  }

  .nav-archive {
    color: var(--color-charcoal);

    div {
      font-family: var(--font-proto-bold);
      font-size: var(--font-size-30);
      position: relative;
      text-transform: uppercase;
      z-index: 1;
    }
  }

  @media (min-width: 620px) {
    :host {
      padding-left: calc(var(--g-gutter) * 2.25);
      padding-right: calc(var(--g-gutter) * 2.25);
    }

    .contents {
      --col-start: 1;
      --col-end: -1;
    }

    ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 730px) {
    a {
      --py: 4rem;
    }
  }

  @media (min-width: 1160px) {
    ul {
      grid-template-columns: repeat(3, 1fr);
    }

    a {
      --py: 5.25rem;
    }
  }

  @media (min-width: 1240px) {
    .contents {
      --col-start: 2;
    }
  }

  @media (min-width: 2200px) {
    .contents {
      --col-start: 3;
    }
  }
</style>

<script webc:bucket="components">
  initDrawStrokes(".nav-link", {
    filterId: "work-nav-warp",
    yBias: "edges",
  });
</script>
